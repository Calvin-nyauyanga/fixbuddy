datasource db {
  provider = "postgresql"
   url     = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// User Model
model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  password  String
  name      String
  phone     String?
  role      String  @default("user") // "user", "agent", "admin"
  status    String  @default("active")
  teamStatus            String    @default("offline") // offline, available, on-break, away (TEAM STATUS)
  avatar    String?
  darkmode  Boolean  @default(false)

  resetToken        String?   @unique
  resetTokenExpire  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketsCreated Ticket[] @relation("CreatedBy")
  ticketsAssigned Ticket[] @relation("AssignedTo")
  comments Comment[]
  activities Activity[]
  chatSessions      ChatSession[]
  chatProfile       UserChatProfile?

  @@map("users")
}

// Ticket Model
model Ticket {
  id          Int     @id @default(autoincrement())
  title       String
  description String  @db.Text
  confidence            Int?     // Added: classification confidence
  sentiment             Json?    // Added: sentiment analysis
  suggestedAgent        String?  // Added: routing suggestion
  estimatedResolutionTime Json?  // Added: SLA estimate
  intelligenceData      Json?    // Added: full analysis stored
  status      String  @default("open") // "open", "in_progress", "closed", "on_hold"
  priority    String  @default("medium")  //"low", "medium", "high", "critical"
  category    String? @default("General")
  userId      String ?

  createdById Int
  createdBy   User    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  assignedToId Int?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?

  comments    Comment[]
  activities  Activity[]
  chatMessages ChatMessage[]

  @@map("tickets")
}

// Comment Model
model Comment {
  id        Int     @id @default(autoincrement())
  content   String @db.Text
  type              String    @default("response") // response, solution, note
  createdAt         DateTime  @default(now())

  ticketId  Int
  ticket    Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@map("comments")
}
model Activity {
  id                Int       @id @default(autoincrement())
  type              String    // ticket_created, ticket_assigned, ticket_solved, admin_login, etc
  details           String    @db.Text
  oldValue          String?   
  newValue          String?
  createdAt         DateTime  @default(now())

  // Relations
  userId            Int?
  user              User?     @relation(fields: [userId], references: [id])
  ticketId          Int?
  ticket            Ticket?   @relation(fields: [ticketId], references: [id])

  @@map("activities")
}
model Settings {
  id        Int     @id @default(autoincrement())
  general   Json    @default("{}")
  email     Json    @default("{}")
  security  Json    @default("{}")
  notifications Json @default("{}")
  appearance Json   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
// ============= CHATBOT MODELS =============

// ChatSession: Tracks individual conversation sessions with the chatbot
model ChatSession {
  id            String    @id @default(cuid())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  language      String    @default("en")   // en, sn, nd
  sessionStatus String    @default("active") // active, closed, escalated
  
  createdAt     DateTime  @default(now())
  closedAt      DateTime?
  updatedAt     DateTime  @updatedAt
  
  messages      ChatMessage[]
  
  @@map("chat_sessions")
  @@index([userId])
  @@index([createdAt])
}

// ChatMessage: Individual messages in a conversation
model ChatMessage {
  id              String    @id @default(cuid())
  sessionId       String
  session         ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  sender          String    @default("user")  // user or bot
  messageType     String    @default("text")  // text, system, escalation
  content         String    @db.Text
  
  // AI Analysis metadata
  category        String?   // hardware, software, network, account, etc.
  sentiment       String?   // positive, neutral, negative
  confidence      Float?    // 0-1 confidence score
  resolvedIssue   Boolean   @default(false)
  
  // If this triggered ticket creation
  ticketId        Int?
  ticket          Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("chat_messages")
  @@index([sessionId])
  @@index([createdAt])
}

// UserChatProfile: Personalization data for each user
model UserChatProfile {
  id                String    @id @default(cuid())
  userId            Int       @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  preferredLanguage String    @default("en")
  skillLevel        String    @default("beginner")  // beginner, intermediate, advanced
  totalQuestionsAsked Int     @default(0)
  issuesResolved    Int       @default(0)
  issuesEscalated   Int       @default(0)
  
  // Preferences
  notificationPreference String @default("email")  // email, sms, push
  chatbotSpeed      String    @default("normal")   // fast, normal, detailed
  
  lastInteraction   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@map("user_chat_profiles")
}

// ChatbotAnalytics: Daily aggregated stats
model ChatbotAnalytics {
  id                    String    @id @default(cuid())
  date                  DateTime
  
  totalSessions         Int       @default(0)
  totalMessages         Int       @default(0)
  issuesResolved        Int       @default(0)
  issuesEscalated       Int       @default(0)
  averageResolutionTime Int       @default(0)  // in minutes
  
  topCategories         Json      @default("[]")  // Array of {category, count}
  topIssues             Json      @default("[]")  // Array of {issue, count}
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@map("chatbot_analytics")
  @@unique([date])
}

